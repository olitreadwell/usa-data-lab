{
  "name": "@uslab/usa-sources",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src/**"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo coverage",
    "clean:all": "rm -rf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo coverage node_modules",
    "test:smoke": "RUN_SMOKE=1 vitest run src/smoke.test.ts"
  },
  "devDependencies": {
    "@uslab/config-eslint": "*",
    "@uslab/config-typescript": "*",
    "@types/node": "22.20.1",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Uniform TypeScript adapters for US public data sources"
}
